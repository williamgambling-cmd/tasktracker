# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:FAoECaWIFgbqwPKhZucQIjClCnYhmtYG@postgres.railway.internal:5432/railway"


# JWT Configuration
# IMPORTANT: Use a strong, random string (at least 32 characters)
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=5b731b5faafb48544a601198e3e5171b82917f6bf4258c2b605a8f009eca1c3f963c4d2a665963c7c0d3c8b761e41350f0cf0481c70e907ba8b3e9774bdb64e9
