# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/tasktracker"


# JWT Configuration
# IMPORTANT: Use a strong, random string (at least 32 characters)
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-at-least-32-characters-long-replace-me
JWT_EXPIRES_IN=7d

# CORS Configuration
# Use '*' for development or comma-separated origins for production
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGIN=*

# Rate Limiting
# Window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Password Hashing
# Number of bcrypt salt rounds (higher = more secure but slower)
BCRYPT_SALT_ROUNDS=12

# Slack Integration (optional)
# Set SLACK_ENABLED=true to show the "Send to Slack" button
SLACK_ENABLED=false
# Bot token from https://api.slack.com/apps — starts with xoxb-
SLACK_BOT_TOKEN=
# Channel ID (right-click channel in Slack > Copy > Copy Link to get it)
SLACK_CHANNEL_ID=
